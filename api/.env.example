# Copia aquest fitxer com a index.env i omple els valors reals.
# index.env NO s'ha de pujar a GitHub.
PORT=3000
MONGO_URI=mongodb://<usuari>:<contrasenya>@localhost:27017/<nom_base_de_dades>?authSource=admin
# Secret per signar els JWT (mínim 32 caràcters). Genera'n un amb:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=canvia-ho
JWT_EXPIRES_IN=1h
